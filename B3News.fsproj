<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>B3News</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Log.fs" />
    <Compile Include="Predictions.fs" />
    <Compile Include="Download.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Lib.fs" />
    <Compile Include="News.fs" />
    <Compile Include="Details.fs" />
    <Compile Include="List.fs" />
    <Compile Include="Fix.fs" />
    <Compile Include="WebServer.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Json" Version="0.4.1" />
    <PackageReference Include="Thoth.Json.Net" Version="11.0.0" />
    <PackageReference Include="Microsoft.ML" Version="3.0.0-preview.22621.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ML/data/B3NewsModel.zip" />
    <EmbeddedResource Include="reports_template.html" />
  </ItemGroup>
</Project>