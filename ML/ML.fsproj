<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Lib.fs" />
    <Compile Include="MultiLabel.fs" />
    <Compile Include="SingleLabel.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 
      Directly referenced to override a transitive vulnerability (NU1903 / GHSA-73j8-2gch-69rq) 
      in Microsoft.Bcl.Memory 9.0.4 coming from Microsoft.ML. 
      Can be removed once upstream packages update their dependency bounds.
    -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />

    <PackageReference Include="Microsoft.Data.Analysis" Version="0.23.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.AutoML" Version="0.23.0" />
  </ItemGroup>
</Project>
